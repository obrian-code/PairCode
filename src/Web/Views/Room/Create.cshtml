@model PairCode.Application.DTOs.CreateRoomDto
@{
    ViewData["Title"] = T["TitleCreateRoom"];
    ViewData["Breadcrumbs"] = new[] {
        new BreadcrumbItem("Rooms", Url.Action("Index")),
        new BreadcrumbItem("Create")
    };
}

@await Html.PartialAsync("_Breadcrumbs")

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="card-title h4">@T["TitleCreateRoom"]</h2>
                <p class="text-muted">
                    @T["CreateRoomDesc"]
                </p>
            </div>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">@T["RoomNameLabel"]</label>
                <input asp-for="Name" class="form-control" placeholder="@T["RoomNamePlaceholder"]" aria-describedby="nameHelp" />
                <span asp-validation-for="Name" class="text-danger"></span>
                <small id="nameHelp" class="text-muted">@T["RoomNameHelp"]</small>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["CreateRoom"]</button>
                <a class="btn btn-outline-secondary" asp-action="Index">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
