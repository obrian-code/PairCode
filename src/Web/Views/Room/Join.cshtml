@model PairCode.Application.DTOs.JoinRoomDto
@{
    ViewData["Title"] = T["TitleJoinRoom"];
    ViewData["Breadcrumbs"] = new[] {
        new BreadcrumbItem("Rooms", Url.Action("Index")),
        new BreadcrumbItem("Join")
    };
}

@await Html.PartialAsync("_Breadcrumbs")

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>@T["TitleJoinRoom"]</h2>
        <hr>
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="AccessCode" class="form-label">@T["AccessCode"]</label>
                <input asp-for="AccessCode" class="form-control" placeholder="@T["AccessCodePlaceholder"]" maxlength="6" style="text-transform:uppercase" />
                <span asp-validation-for="AccessCode" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@T["Join"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@T["Cancel"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector("form")?.addEventListener("submit", function() {
            const input = this.querySelector("[name='AccessCode']");
            if (input) input.value = input.value.toUpperCase();
        });
    </script>
}
