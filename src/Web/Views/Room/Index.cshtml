@model PairCode.Application.DTOs.PagedResult<PairCode.Application.DTOs.RoomDto>
@{
    ViewData["Title"] = "Rooms";
    ViewData["Breadcrumbs"] = new[] { new KeyValuePair<string, string>("Rooms", string.Empty) };
}

@await Html.PartialAsync("_Breadcrumbs")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Rooms</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Create">Create Room</a>
        <a class="btn btn-outline-primary" asp-action="Join">Join Room</a>
    </div>
</div>

<div class="mb-3">
    <input id="roomSearch" class="form-control" placeholder="Search rooms by name..." aria-label="Search rooms" />
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-icon">&#x1F3E0;</div>
        <h5>No rooms yet</h5>
        <p class="text-muted">Create a new room or join one using an access code.</p>
        <a class="btn btn-primary" asp-action="Create">Create Your First Room</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover" id="roomsTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Status</th>
                    <th>Participants</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model.Items)
                {
                    <tr data-name="@room.Name.ToLowerInvariant()">
                        <td>@room.Name</td>
                        <td><strong>@room.AccessCode</strong></td>
                        <td>
                            <span class="badge @(room.Status switch {
                                "Active" => "bg-success",
                                "Finished" => "bg-secondary",
                                "Cancelled" => "bg-danger",
                                _ => "bg-warning"
                            })">@room.Status</span>
                        </td>
                        <td>@room.ParticipantCount</td>
                        <td>@room.CreatedAt.ToString("g")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@room.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Room pagination">
        <ul class="pagination justify-content-center">
            @if (Model.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">&laquo; Previous</a>
                </li>
            }
            @for (var i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                </li>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Next &raquo;</a>
                </li>
            }
        </ul>
        <p class="text-muted text-center small">Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount total rooms)</p>
    </nav>
}

@section Scripts {
    <script>
        document.getElementById("roomSearch")?.addEventListener("input", function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll("#roomsTable tbody tr").forEach(row => {
                row.style.display = row.dataset.name.includes(q) ? "" : "none";
            });
        });
    </script>
}
