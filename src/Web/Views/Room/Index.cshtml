@model PairCode.Application.DTOs.PagedResult<PairCode.Application.DTOs.RoomDto>
@{
    ViewData["Title"] = T["TitleRooms"];
    ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("Rooms") };
}

@await Html.PartialAsync("_Breadcrumbs")

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@T["TitleRooms"]</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Create">@T["CreateRoom"]</a>
        <a class="btn btn-outline-primary" asp-action="Join">@T["JoinRoom"]</a>
    </div>
</div>

<div class="mb-3">
    <input id="roomSearch" class="form-control" placeholder="@T["SearchRooms"]" aria-label="@T["SearchRoomsLabel"]" />
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-icon" role="img" aria-label="House">&#x1F3E0;</div>
        <h5>@T["NoRoomsYet"]</h5>
        <p class="text-muted">@T["NoRoomsDesc"]</p>
        <a class="btn btn-primary" asp-action="Create">@T["CreateYourFirstRoom"]</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover" id="roomsTable">
            <thead>
                <tr>
                    <th>@T["NameHeader"]</th>
                    <th>@T["Code"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Participants"]</th>
                    <th>@T["Created"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model.Items)
                {
                    <tr data-name="@room.Name.ToLowerInvariant()">
                        <td>@room.Name</td>
                        <td><strong>@room.AccessCode</strong></td>
                        <td>
                            <span class="badge @(room.Status switch {
                                "Active" => "bg-success",
                                "Finished" => "bg-secondary",
                                "Cancelled" => "bg-danger",
                                _ => "bg-warning"
                            })"><span aria-hidden="true">@(room.Status switch {
                                "Active" => "✓ ",
                                "Finished" => "◉ ",
                                "Cancelled" => "✗ ",
                                _ => ""
                            })</span>@room.Status</span>
                        </td>
                        <td>@room.ParticipantCount</td>
                        <td>@room.CreatedAt.ToString("g")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@room.Id">@T["Open"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Room pagination">
        <ul class="pagination justify-content-center">
            @if (Model.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">&laquo; @T["Previous"]</a>
                </li>
            }
            @for (var i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                </li>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">@T["Next"] &raquo;</a>
                </li>
            }
        </ul>
        <p class="text-muted text-center small">@T["ShowingPageRooms", Model.Page, Model.TotalPages, Model.TotalCount]</p>
    </nav>
}

@section Scripts {
    <script>
        document.getElementById("roomSearch")?.addEventListener("input", function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll("#roomsTable tbody tr").forEach(row => {
                row.style.display = row.dataset.name.includes(q) ? "" : "none";
            });
        });
    </script>
}
