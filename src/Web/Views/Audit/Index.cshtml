@model PairCode.Application.DTOs.PagedResult<PairCode.Application.DTOs.AuditLogDto>
@{
    ViewData["Title"] = "Audit Log";
    ViewData["Breadcrumbs"] = new[] { new KeyValuePair<string, string>("Audit", string.Empty) };
}

@await Html.PartialAsync("_Breadcrumbs")

<h2>Audit Log</h2>
<hr>

<div class="mb-3">
    <input id="auditSearch" class="form-control" placeholder="Search by user, action, or details..." aria-label="Search audit logs" />
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-icon">&#x1F50D;</div>
        <h5>No audit records</h5>
        <p class="text-muted">Audit logs will appear here as users perform actions.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped" id="auditTable">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Items)
                {
                    <tr>
                        <td>@log.UserName</td>
                        <td>
                            <span class="badge @(log.Action switch {
                                "CreateRoom" or "Register" => "bg-success",
                                "DeleteRoom" => "bg-danger",
                                "CloseRoom" or "CancelRoom" => "bg-warning text-dark",
                                _ => "bg-info text-dark"
                            })">@log.Action</span>
                        </td>
                        <td>@log.EntityName</td>
                        <td>@log.Details</td>
                        <td>@log.Timestamp.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Audit pagination">
        <ul class="pagination justify-content-center">
            @if (Model.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">&laquo; Previous</a>
                </li>
            }
            @for (var i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                </li>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Next &raquo;</a>
                </li>
            }
        </ul>
        <p class="text-muted text-center small">Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount total records)</p>
    </nav>
}

@section Scripts {
    <script>
        document.getElementById("auditSearch")?.addEventListener("input", function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll("#auditTable tbody tr").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? "" : "none";
            });
        });
    </script>
}
