@model IEnumerable<PairCode.Application.DTOs.AuditLogDto>
@{
    ViewData["Title"] = "Audit Log";
    ViewData["Breadcrumbs"] = new[] { new KeyValuePair<string, string>("Audit", string.Empty) };
}

@await Html.PartialAsync("_Breadcrumbs")

<h2>Audit Log</h2>
<hr>

<div class="mb-3">
    <input id="auditSearch" class="form-control" placeholder="Search by user, action, or details..." aria-label="Search audit logs" />
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">&#x1F50D;</div>
        <h5>No audit records</h5>
        <p class="text-muted">Audit logs will appear here as users perform actions.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped" id="auditTable">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.UserName</td>
                        <td>
                            <span class="badge @(log.Action switch {
                                "CreateRoom" or "Register" => "bg-success",
                                "DeleteRoom" => "bg-danger",
                                "CloseRoom" or "CancelRoom" => "bg-warning text-dark",
                                _ => "bg-info text-dark"
                            })">@log.Action</span>
                        </td>
                        <td>@log.EntityName</td>
                        <td>@log.Details</td>
                        <td>@log.Timestamp.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        document.getElementById("auditSearch")?.addEventListener("input", function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll("#auditTable tbody tr").forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? "" : "none";
            });
        });
    </script>
}
