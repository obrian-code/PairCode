@model PairCode.Application.DTOs.UserProfileDto
@{
    ViewData["Title"] = T["TitleProfile"];
    ViewData["Breadcrumbs"] = new[] { new BreadcrumbItem("Profile") };
}

@await Html.PartialAsync("_Breadcrumbs")

@if (TempData["SuccessMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>@T["TitleProfile"]</h2>
        <hr>
        
        <div class="d-flex align-items-center mb-4 p-3 bg-light rounded">
            <div class="avatar avatar-lg me-3" style="background-color: #2563eb;">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>
            <div>
                <h4 class="mb-0">@Model.Name</h4>
                <span class="badge bg-secondary">@Model.Role</span>
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-4">@T["Name"]</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">@T["Email"]</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">@T["Role"]</dt>
            <dd class="col-sm-8">@Model.Role</dd>

            <dt class="col-sm-4">@T["MemberSince"]</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToString("g")</dd>
        </dl>

        <hr>
        <h4>@T["UpdateName"]</h4>
        <form asp-controller="Profile" asp-action="Update" method="post" class="mb-4">
            @Html.AntiForgeryToken()
            <div class="input-group mb-3">
                <input name="name" class="form-control" value="@Model.Name" required />
                <button type="submit" class="btn btn-primary">@T["Update"]</button>
            </div>
        </form>

        <hr>
        <h4>@T["ChangePassword"]</h4>
        <form asp-controller="Profile" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label for="CurrentPassword" class="form-label">@T["CurrentPassword"]</label>
                <input name="CurrentPassword" type="password" class="form-control" required />
                <span asp-validation-for="@(new PairCode.Application.DTOs.ChangePasswordDto("","").CurrentPassword)" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label for="NewPassword" class="form-label">@T["NewPassword"]</label>
                <input name="NewPassword" type="password" class="form-control" required minlength="8" pattern="(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z\d]).{8,}" title="At least 8 characters, one uppercase, one digit, one special character." />
                <div class="form-text">@T["PasswordRequirements"]</div>
            </div>
            <button type="submit" class="btn btn-warning">@T["ChangePassword"]</button>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="History" class="btn btn-outline-info">@T["ViewSessionHistory"]</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
