@{
    ViewData["Title"] = T["WelcomeTo"];
}

<div class="text-center py-5">
    <div style="font-size: 4rem; margin-bottom: 1rem;" aria-hidden="true">&#x1F4BB;</div>
    <h1 class="display-4 fw-bold">@T["WelcomeTo"]</h1>
    <p class="lead text-muted mx-auto" style="max-width: 600px;">
        @T["AppDescription"]
    </p>
    <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
        <a class="btn btn-primary btn-lg px-4" asp-controller="Auth" asp-action="Register">@T["GetStarted"]</a>
        <a class="btn btn-outline-primary btn-lg px-4" asp-controller="Auth" asp-action="Login">@T["SignIn"]</a>
    </div>
</div>

<hr class="my-5">

<div class="row g-4 text-center">
    <div class="col-md-4">
        <div class="p-3">
            <div style="font-size: 2.5rem;" aria-hidden="true">&#x1F468;&#x200D;&#x1F4BB;</div>
            <h5 class="mt-2">@T["CodeTogether"]</h5>
            <p class="text-muted">@T["CodeTogetherDesc"]</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3">
            <div style="font-size: 2.5rem;" aria-hidden="true">&#x1F4AC;</div>
            <h5 class="mt-2">@T["BuiltInChat"]</h5>
            <p class="text-muted">@T["BuiltInChatDesc"]</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3">
            <div style="font-size: 2.5rem;" aria-hidden="true">&#x1F3AF;</div>
            <h5 class="mt-2">@T["RoleManagement"]</h5>
            <p class="text-muted">@T["RoleManagementDesc"]</p>
        </div>
    </div>
</div>
