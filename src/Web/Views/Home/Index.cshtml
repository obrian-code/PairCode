@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center py-5">
    <div style="font-size: 4rem; margin-bottom: 1rem;">&#x1F4BB;</div>
    <h1 class="display-4 fw-bold">Welcome to PairCode</h1>
    <p class="lead text-muted mx-auto" style="max-width: 600px;">
        Real-time collaborative coding platform for technical interviews and pair programming sessions.
    </p>
    <div class="mt-4 d-flex justify-content-center gap-3 flex-wrap">
        <a class="btn btn-primary btn-lg px-4" asp-controller="Auth" asp-action="Register">Get Started</a>
        <a class="btn btn-outline-primary btn-lg px-4" asp-controller="Auth" asp-action="Login">Sign In</a>
    </div>
</div>

<hr class="my-5">

<div class="row g-4 text-center">
    <div class="col-md-4">
        <div class="p-3">
            <div style="font-size: 2.5rem;">&#x1F468;&#x200D;&#x1F4BB;</div>
            <h5 class="mt-2">Code Together</h5>
            <p class="text-muted">Real-time collaborative editor with syntax highlighting and version tracking.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3">
            <div style="font-size: 2.5rem;">&#x1F4AC;</div>
            <h5 class="mt-2">Built-in Chat</h5>
            <p class="text-muted">Communicate instantly with your pair using real-time messaging.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3">
            <div style="font-size: 2.5rem;">&#x1F3AF;</div>
            <h5 class="mt-2">Role Management</h5>
            <p class="text-muted">Admin, Interviewer, and Candidate roles with tailored permissions.</p>
        </div>
    </div>
</div>
