@{
    ViewData["Title"] = T["AppName"];
}

<div class="text-center py-4">
    <div style="font-size: 3rem; margin-bottom: 0.5rem;" role="img" aria-label="Wave">&#x1F44B;</div>
    <h1>@T["WelcomeUser", User.Identity?.Name]</h1>
    <p class="lead text-muted">@T["WhatToDoToday"]</p>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-4">
                <div style="font-size: 2.5rem;" role="img" aria-label="Plus">&#x2795;</div>
                <h5 class="card-title mt-2">@T["CreateRoomCard"]</h5>
                <p class="card-text text-muted">@T["CreateRoomCardDesc"]</p>
                <a class="btn btn-primary" asp-controller="Room" asp-action="Create">@T["Create"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-4">
                <div style="font-size: 2.5rem;" role="img" aria-label="Search">&#x1F50D;</div>
                <h5 class="card-title mt-2">@T["JoinRoomCard"]</h5>
                <p class="card-text text-muted">@T["JoinRoomCardDesc"]</p>
                <a class="btn btn-outline-primary" asp-controller="Room" asp-action="Join">@T["Join"]</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-4">
                <div style="font-size: 2.5rem;" role="img" aria-label="Chart">&#x1F4CA;</div>
                <h5 class="card-title mt-2">@T["DashboardCard"]</h5>
                <p class="card-text text-muted">@T["DashboardCardDesc"]</p>
                <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="Index">@T["View"]</a>
            </div>
        </div>
    </div>
</div>
